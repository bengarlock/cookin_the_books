# Safe to expose only if browser-side requests will call the API directly.
# The server prefers PORTFOLIO_API_BASE_URL when both are set.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Recommended server-only portfolio_database URL.
PORTFOLIO_API_BASE_URL=http://127.0.0.1:8000

# Optional. Defaults to the WebSocket equivalent of PORTFOLIO_API_BASE_URL.
PORTFOLIO_WEBSOCKET_BASE_URL=ws://127.0.0.1:8000

# Keep false or unset in production. DS9's isolated HTTP-only staging host sets
# this to true because it proxies the backend over its private LAN.
ALLOW_INSECURE_API_BASE_URL=false

# Production defaults to a secure cookie shared by bengarlock.com subdomains.
# For plain-HTTP staging hosts, set false and leave the domain empty.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=.bengarlock.com

# Authentication cookie settings. Never put credentials or API tokens here.
AUTH_COOKIE_NAME=cookinTheBooksToken
AUTH_COOKIE_MAX_AGE_SECONDS=86400
